# Copy to .env (git-ignored). Never commit a real key.

# Required for generation. Get one at https://openrouter.ai/keys
# (legacy OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL still work)
OPENROUTER_API_KEY=sk-or-...

# Optional: a different OpenAI-compatible endpoint.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: model overrides (default: src/llm/models.json). One model for everything, or per task
# (scaffold, lesson, outline, author, judge, repair).
# LLM_MODEL=google/gemini-3.1-flash-lite
# LLM_MODEL_JUDGE=anthropic/claude-haiku-4.5

# Optional: monthly spend cap per family in USD. Unset means unlimited.
# LLM_CAP_FAMILY_MONTH_USD=5

# Privacy routing. A child's first name, grade, interests and the parent's notes go to the model
# provider. strict = only endpoints with zero data retention that do not train on prompts;
# no-training = no training/collection; off = provider default.
# Defaults to strict when AGENTIC_HOSTED=1, else off.
# AGENTIC_HOSTED=1
# LLM_PRIVACY_ROUTING=strict
